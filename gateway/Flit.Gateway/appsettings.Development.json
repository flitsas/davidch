{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "identity-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "frontend-route": {
        "ClusterId": "frontend",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5080"
          }
        }
      },
      "frontend": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:3000"
          }
        }
      }
    }
  }
}
